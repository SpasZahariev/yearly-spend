# LLM provider: "local" (default, llama-server) or "gemini" (only when a key is present)
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=sk-local-token
# The model id reported by the local server's /v1/models endpoint
LLM_MODEL=
# Only active when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DB_PATH=data/spend.duckdb
